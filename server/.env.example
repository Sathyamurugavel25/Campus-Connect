PORT=5000
# Leave MONGO_URI empty to use the embedded local MongoDB (zero setup). For Atlas paste your connection string.
MONGO_URI=
JWT_SECRET=change_this_to_a_long_random_text
CLIENT_URL=http://localhost:5173
# Email rules: student101@DOMAIN, facultycse1@DOMAIN, hodcse@DOMAIN, admin@DOMAIN
COLLEGE_DOMAIN=college.edu
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=Admin@123
# Only needed to sign up as Admin from the website. Change it!
ADMIN_CODE=ADMIN2026
# true = faculty clubs/events/important announcements wait for HOD approval. false = go live instantly.
REQUIRE_APPROVAL=true
